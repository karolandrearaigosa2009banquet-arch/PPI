# Copia este archivo a .env.local (o .env) y rellena tus valores. Nunca subas el .env a Git.
# En producción (GitHub Pages) estos valores salen de GitHub Secrets: Settings → Secrets and variables → Actions.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY
